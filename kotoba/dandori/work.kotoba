;; dandori.work — how a member of a team, human or bot, takes work from a
;; dandori board (Linear JUN-310; com-junkawasaki/root ADR-2610222130). Pure
;; decisions over dandori.core's encoding; the board, the clock and the lease
;; registry stay with the caller.
;;
;;   role      1 = steward (幹事: triage and planning), 2 = worker (担当: doing)
;;   assignee  0 = nobody, 1 = the asker, 2 = someone else
;;
;;   take-reason  may this member take this issue now, and why:
;;                take/resume  a started issue of mine whose claim lapsed
;;                             (I stopped mid-way; pick it up again)
;;                take/orphan  a started issue of someone else whose claim
;;                             lapsed (they stopped; the work does not)
;;                take/new     an unstarted issue, mine or nobody's
;;                take/plan    a steward's triage or backlog issue
;;                refusals: take/closed, take/held (a live claim),
;;                take/blocked (an open blocker), take/assigned-other,
;;                take/not-role, take/invalid
;;   take-ok?     one of the four takes
;;   before?      which of two takeable issues goes first: resume, then
;;                orphan, then new or plan; then the SLA stage (breached
;;                first); then priority-rank (Urgent first, No priority last);
;;                then the lower number (the older issue)
;;   move-reason  may this role move an issue from one state type to another:
;;                move/ok, move/no-op, move/invalid, move/not-allowed. A worker
;;                starts, completes, or gives back (started -> unstarted). A
;;                steward triages, plans, cancels, pulls a started issue back
;;                and reopens; it does not complete someone's work.
;;
;; A claim is a sahai lease (kotoba-lang/sahai kotoba/sahai/fence.kotoba): the
;; caller passes whether it is live. Taking an issue is a claim; the claim's
;; epoch fences a stale holder, so an orphan is taken once.
;;
;; Written in the Amu selfhost seed subset, after kotoba/dandori/core.kotoba
;; (priority-rank, transition-kind); README "Kotoba" has the gate.
(ns dandori.work
  (:export [take-reason take-ok? before? move-reason
            test-take test-take-ok test-before test-move]))

;; ---------------------------------------------------------------------------
;; Taking

(defn take-reason [state :i64 role :i64 assignee :i64 open-blockers :i64 claim-live :bool] :string
  (cond
    (or (< state 0) (> state 5) (< role 1) (> role 2) (< assignee 0) (> assignee 2)) "take/invalid"
    (or (= state 4) (= state 5)) "take/closed"
    claim-live "take/held"
    (> open-blockers 0) "take/blocked"
    (= state 3) (cond (not (= role 2)) "take/not-role"
                      (= assignee 1) "take/resume"
                      :else "take/orphan")
    (= state 2) (cond (not (= role 2)) "take/not-role"
                      (= assignee 2) "take/assigned-other"
                      :else "take/new")
    ;; triage (0) and backlog (1)
    (not (= role 1)) "take/not-role"
    :else "take/plan"))

(defn take-ok? [reason :string] :bool
  (or (= reason "take/resume") (= reason "take/orphan")
      (= reason "take/new") (= reason "take/plan")))

;; resume 0, orphan 1, new and plan 2
(defn take-rank [reason :string] :i64
  (cond (= reason "take/resume") 0
        (= reason "take/orphan") 1
        :else 2))

;; priority-rank with an out-of-range priority last
(defn priority-order [p :i64] :i64
  (let [r (priority-rank p)] (if (< r 0) 5 r)))

(defn before? [ra :string sla-a :i64 pa :i64 na :i64
               rb :string sla-b :i64 pb :i64 nb :i64] :bool
  (let [ka (take-rank ra) kb (take-rank rb)
        qa (priority-order pa) qb (priority-order pb)]
    (cond (< ka kb) true
          (> ka kb) false
          (> sla-a sla-b) true
          (< sla-a sla-b) false
          (< qa qb) true
          (> qa qb) false
          :else (< na nb))))

;; ---------------------------------------------------------------------------
;; Moving

(defn worker-may? [from :i64 to :i64] :bool
  (or (and (= from 2) (= to 3))
      (and (= from 3) (= to 4))
      (and (= from 3) (= to 2))))

(defn steward-may? [from :i64 to :i64] :bool
  (cond (= to 4) false
        (= to 3) false
        (or (= from 4) (= from 5)) (= to 2)
        (= to 5) true
        (= from 0) (or (= to 1) (= to 2))
        (= from 1) (= to 2)
        (= from 2) (= to 1)
        (= from 3) (= to 2)
        :else false))

(defn move-reason [role :i64 from :i64 to :i64] :string
  (let [kind (transition-kind from to)]
    (cond (or (< kind 0) (< role 1) (> role 2)) "move/invalid"
          (= kind 0) "move/no-op"
          (= role 2) (if (worker-may? from to) "move/ok" "move/not-allowed")
          :else (if (steward-may? from to) "move/ok" "move/not-allowed"))))

;; ---------------------------------------------------------------------------
;; test-* : zero-arity, true when every assertion holds.

(defn test-take [] :bool
  (if (and (= (take-reason 2 2 0 0 false) "take/new")
           (= (take-reason 2 2 1 0 false) "take/new")
           (= (take-reason 2 2 2 0 false) "take/assigned-other")
           (= (take-reason 3 2 1 0 false) "take/resume")
           (= (take-reason 3 2 2 0 false) "take/orphan")
           (= (take-reason 3 2 0 0 false) "take/orphan")
           ;; a live claim holds, whoever holds it
           (= (take-reason 3 2 1 0 true) "take/held")
           (= (take-reason 2 2 0 0 true) "take/held")
           (= (take-reason 2 2 0 1 false) "take/blocked")
           (= (take-reason 3 2 2 2 false) "take/blocked")
           (= (take-reason 4 2 1 0 false) "take/closed")
           (= (take-reason 5 1 0 0 false) "take/closed")
           ;; stewards plan, workers do
           (= (take-reason 0 1 0 0 false) "take/plan")
           (= (take-reason 1 1 2 0 false) "take/plan")
           (= (take-reason 1 2 0 0 false) "take/not-role")
           (= (take-reason 2 1 0 0 false) "take/not-role")
           (= (take-reason 3 1 2 0 false) "take/not-role")
           (= (take-reason 6 2 0 0 false) "take/invalid")
           (= (take-reason 2 3 0 0 false) "take/invalid")
           (= (take-reason 2 2 3 0 false) "take/invalid"))
    true false))

(defn test-take-ok [] :bool
  (if (and (take-ok? "take/resume") (take-ok? "take/orphan")
           (take-ok? "take/new") (take-ok? "take/plan")
           (not (take-ok? "take/held")) (not (take-ok? "take/blocked"))
           (not (take-ok? "take/closed")) (not (take-ok? "take/not-role"))
           (not (take-ok? "take/assigned-other")) (not (take-ok? "take/invalid")))
    true false))

(defn test-before [] :bool
  (if (and ;; finish what was started before starting
           (before? "take/resume" 0 4 9 "take/new" 3 1 1)
           (before? "take/orphan" 0 0 9 "take/new" 3 1 1)
           (before? "take/resume" 0 0 9 "take/orphan" 3 1 1)
           (not (before? "take/new" 3 1 1 "take/orphan" 0 0 9))
           ;; then the SLA stage, then priority, then the older issue
           (before? "take/new" 3 4 9 "take/new" 2 1 1)
           (before? "take/new" 1 1 9 "take/new" 1 2 1)
           (before? "take/new" 1 4 9 "take/new" 1 0 1)
           (before? "take/new" 1 2 3 "take/new" 1 2 4)
           (not (before? "take/new" 1 2 4 "take/new" 1 2 3))
           (not (before? "take/new" 1 2 4 "take/new" 1 2 4))
           ;; an out-of-range priority goes after No priority
           (before? "take/new" 0 0 9 "take/new" 0 7 1))
    true false))

(defn test-move [] :bool
  (if (and (= (move-reason 2 2 3) "move/ok")
           (= (move-reason 2 3 4) "move/ok")
           (= (move-reason 2 3 2) "move/ok")
           (= (move-reason 2 3 5) "move/not-allowed")
           (= (move-reason 2 4 2) "move/not-allowed")
           (= (move-reason 2 0 2) "move/not-allowed")
           (= (move-reason 1 0 1) "move/ok")
           (= (move-reason 1 0 2) "move/ok")
           (= (move-reason 1 1 2) "move/ok")
           (= (move-reason 1 2 1) "move/ok")
           (= (move-reason 1 3 2) "move/ok")
           (= (move-reason 1 2 5) "move/ok")
           (= (move-reason 1 4 2) "move/ok")
           (= (move-reason 1 5 2) "move/ok")
           (= (move-reason 1 3 4) "move/not-allowed")
           (= (move-reason 1 2 3) "move/not-allowed")
           (= (move-reason 1 4 0) "move/not-allowed")
           (= (move-reason 2 3 3) "move/no-op")
           (= (move-reason 2 6 3) "move/invalid")
           (= (move-reason 3 2 3) "move/invalid"))
    true false))
