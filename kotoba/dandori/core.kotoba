;; dandori.core — the judgment core of aiueos/dandori_core.cljk, in .kotoba
;; (Linear JUN-295 step 1, JUN-310). Same functions, same encoding, same
;; results: priority-rank, estimate-valid?, closed?, active?, transition-kind,
;; cycle-progress-permille, sla-status, next-number.
;;
;;   state type  triage=0 backlog=1 unstarted=2 started=3 completed=4 canceled=5
;;   priority    0=No priority 1=Urgent 2=High 3=Medium 4=Low
;;   scale       notUsed=0 exponential=1 fibonacci=2 linear=3 tShirt=4
;;               (tShirt holds fibonacci numbers: XS=1 S=2 M=3 L=5 XL=8,
;;                extended XXL=13 XXXL=21)
;;
;; Buffers: cycle-progress-permille takes [state-type estimate] x n,
;; next-number takes issue numbers x n.
;;
;; test-* carry the 73 rows of test/fixtures/parity.edn, one test per
;; function (priority-rank 7 / estimate-valid? 22 / closed? 5 / active? 3 /
;; transition-kind 14 / cycle-progress-permille 11 / sla-status 7 /
;; next-number 4), the same rows as the .cljk guest. Change the table and
;; this file together.
;;
;; Differences from the .cljk guest, all of form, none of result: helpers are
;; defined before their callers and are plain defn (the seed subset has no
;; defn- and no ns docstring), and test-* return :bool. The .cljk guest and
;; its wasm stay until JUN-295 moves the adapter and the screen.
;;
;; Written in the Amu selfhost seed subset; README "Kotoba" has the gate.
(ns dandori.core
  (:export [priority-rank estimate-valid? closed? active? transition-kind
            cycle-progress-permille sla-status next-number
            test-priority-rank test-estimate-valid test-closed test-active
            test-transition-kind test-cycle-progress test-sla-status
            test-next-number]))

;; ---------------------------------------------------------------------------
;; Priority: Urgent first, No priority last, -1 outside 0..4.

(defn priority-rank [p :i64] :i64
  (cond
    (= p 1) 0
    (= p 2) 1
    (= p 3) 2
    (= p 4) 3
    (= p 0) 4
    :else -1))

;; ---------------------------------------------------------------------------
;; Estimates

(defn exponential-member [v :i64 extended :i64] :i64
  (cond
    (or (= v 1) (= v 2) (= v 4) (= v 8) (= v 16)) 1
    (and (= extended 1) (or (= v 32) (= v 64))) 1
    :else 0))

(defn fibonacci-member [v :i64 extended :i64] :i64
  (cond
    (or (= v 1) (= v 2) (= v 3) (= v 5) (= v 8)) 1
    (and (= extended 1) (or (= v 13) (= v 21))) 1
    :else 0))

(defn linear-member [v :i64 extended :i64] :i64
  (if (<= v (if (= extended 1) 7 5)) 1 0))

(defn estimate-valid? [scale :i64 value :i64 allow-zero :i64 extended :i64] :i64
  (cond
    (= scale 0) 0
    (< value 0) 0
    (= value 0) (if (and (>= scale 1) (<= scale 4) (= allow-zero 1)) 1 0)
    (= scale 1) (exponential-member value extended)
    (= scale 2) (fibonacci-member value extended)
    (= scale 3) (linear-member value extended)
    (= scale 4) (fibonacci-member value extended)
    :else 0))

;; ---------------------------------------------------------------------------
;; Workflow. transition-kind: 0 no-op, 1 start, 2 complete, 3 cancel,
;; 4 reopen (closed -> open), 5 other, -1 a type outside 0..5.

(defn valid-type [t :i64] :i64
  (if (and (>= t 0) (<= t 5)) 1 0))

(defn closed? [t :i64] :i64
  (if (or (= t 4) (= t 5)) 1 0))

(defn active? [t :i64] :i64
  (if (= t 3) 1 0))

(defn transition-kind [from :i64 to :i64] :i64
  (cond
    (= (valid-type from) 0) -1
    (= (valid-type to) 0) -1
    (= from to) 0
    (= to 4) 2
    (= to 5) 3
    (= (closed? from) 1) 4
    (= to 3) 1
    :else 5))

;; ---------------------------------------------------------------------------
;; Cycle progress over [state-type estimate] x n, in permille. Canceled is out
;; of scope; estimate 0 counts as unestimated-weight; -1 for an odd buffer, a
;; negative estimate or a type outside 0..5.

(defn cycle-progress-at [buf :vector-i64 n :i64 w :i64 i :i64 scope :i64 done :i64] :i64
  (if (< i n)
    (let [t (vector-at buf i)
          e (vector-at buf (+ i 1))]
      (cond
        (= (valid-type t) 0) -1
        (< e 0) -1
        (= t 5) (cycle-progress-at buf n w (+ i 2) scope done)
        :else (let [weight (if (= e 0) w e)]
                (cycle-progress-at buf n w (+ i 2)
                                   (+ scope weight)
                                   (if (= t 4) (+ done weight) done)))))
    (if (= scope 0)
      0
      (quot (* done 1000) scope))))

(defn cycle-progress-permille [buf :vector-i64 unestimated-weight :i64] :i64
  (let [n (vector-count buf)]
    (if (= n (* 2 (quot n 2)))
      (cycle-progress-at buf n unestimated-weight 0 0 0)
      -1)))

;; ---------------------------------------------------------------------------
;; SLA: 0 ok, 1 medium, 2 high, 3 breached; a threshold of 0 is unset.

(defn sla-status [now :i64 medium-at :i64 high-at :i64 breach-at :i64] :i64
  (cond
    (and (> breach-at 0) (>= now breach-at)) 3
    (and (> high-at 0) (>= now high-at)) 2
    (and (> medium-at 0) (>= now medium-at)) 1
    :else 0))

;; ---------------------------------------------------------------------------
;; Numbering: one past the largest number, never below 1.

(defn max-number [buf :vector-i64 n :i64 i :i64 best :i64] :i64
  (if (< i n)
    (max-number buf n (+ i 1) (max best (vector-at buf i)))
    best))

(defn next-number [buf :vector-i64] :i64
  (+ (max-number buf (vector-count buf) 0 0) 1))

;; ---------------------------------------------------------------------------
;; test-* : zero-arity, true when every row holds (test/fixtures/parity.edn).

(defn test-priority-rank [] :bool
  (if (and (= (priority-rank 1) 0)
           (= (priority-rank 2) 1)
           (= (priority-rank 3) 2)
           (= (priority-rank 4) 3)
           (= (priority-rank 0) 4)
           (= (priority-rank 5) -1)
           (= (priority-rank -1) -1))
    true false))

(defn test-estimate-valid [] :bool
  (if (and (= (estimate-valid? 1 8 0 0) 1)
           (= (estimate-valid? 1 3 0 0) 0)
           (= (estimate-valid? 1 32 0 0) 0)
           (= (estimate-valid? 1 32 0 1) 1)
           (= (estimate-valid? 1 64 0 1) 1)
           (= (estimate-valid? 2 5 0 0) 1)
           (= (estimate-valid? 2 4 0 0) 0)
           (= (estimate-valid? 2 13 0 0) 0)
           (= (estimate-valid? 2 21 0 1) 1)
           (= (estimate-valid? 3 5 0 0) 1)
           (= (estimate-valid? 3 6 0 0) 0)
           (= (estimate-valid? 3 7 0 1) 1)
           (= (estimate-valid? 3 8 0 1) 0)
           (= (estimate-valid? 4 8 0 0) 1)
           (= (estimate-valid? 4 13 0 1) 1)
           (= (estimate-valid? 4 4 0 1) 0)
           (= (estimate-valid? 2 0 0 0) 0)
           (= (estimate-valid? 2 0 1 0) 1)
           (= (estimate-valid? 0 0 1 1) 0)
           (= (estimate-valid? 0 1 0 0) 0)
           (= (estimate-valid? 2 -1 1 1) 0)
           (= (estimate-valid? 9 1 0 0) 0))
    true false))

(defn test-closed [] :bool
  (if (and (= (closed? 4) 1)
           (= (closed? 5) 1)
           (= (closed? 3) 0)
           (= (closed? 0) 0)
           (= (closed? 7) 0))
    true false))

(defn test-active [] :bool
  (if (and (= (active? 3) 1)
           (= (active? 2) 0)
           (= (active? 4) 0))
    true false))

(defn test-transition-kind [] :bool
  (if (and (= (transition-kind 2 2) 0)
           (= (transition-kind 2 3) 1)
           (= (transition-kind 1 3) 1)
           (= (transition-kind 3 4) 2)
           (= (transition-kind 0 4) 2)
           (= (transition-kind 3 5) 3)
           (= (transition-kind 4 5) 3)
           (= (transition-kind 4 2) 4)
           (= (transition-kind 5 3) 4)
           (= (transition-kind 5 0) 4)
           (= (transition-kind 0 1) 5)
           (= (transition-kind 3 2) 5)
           (= (transition-kind 6 2) -1)
           (= (transition-kind 2 -1) -1))
    true false))

(defn test-cycle-progress [] :bool
  (if (and (= (cycle-progress-permille [] 1) 0)
           (= (cycle-progress-permille [4 3 3 2 2 5] 1) 300)
           (= (cycle-progress-permille [4 3 5 8 3 1] 1) 750)
           (= (cycle-progress-permille [4 0 2 0 2 0] 1) 333)
           (= (cycle-progress-permille [4 0 2 2] 0) 0)
           (= (cycle-progress-permille [4 0 2 2] 2) 500)
           (= (cycle-progress-permille [5 3 5 2] 1) 0)
           (= (cycle-progress-permille [4 1 4 2] 1) 1000)
           (= (cycle-progress-permille [4 3 2] 1) -1)
           (= (cycle-progress-permille [4 -1] 1) -1)
           (= (cycle-progress-permille [9 1] 1) -1))
    true false))

(defn test-sla-status [] :bool
  (if (and (= (sla-status 100 0 0 0) 0)
           (= (sla-status 100 200 300 400) 0)
           (= (sla-status 200 200 300 400) 1)
           (= (sla-status 350 200 300 400) 2)
           (= (sla-status 400 200 300 400) 3)
           (= (sla-status 500 0 0 400) 3)
           (= (sla-status 350 0 300 0) 2))
    true false))

(defn test-next-number [] :bool
  (if (and (= (next-number []) 1)
           (= (next-number [1 2 3]) 4)
           (= (next-number [7 2 41]) 42)
           (= (next-number [-5 0]) 1))
    true false))
