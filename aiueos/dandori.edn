;; dandori 課題トラッキング dapp — aiueos アプリ記述子（形は examples/apps/notes.edn
;; と cloud-itonami/kaikei の aiueos/kaikei.edn に準拠）。
;; 実装の正本: dandori_core.cljk / docs/aiueos-dapp.md。
;;
;; 判断コア guest（:effects #{}）を指す。imports は無し —— 優先度の並び・見積の
;; 妥当性・遷移の種類・サイクル進捗・SLA・採番は計算だけで、I/O（取り込み・
;; 保存・同期）はこの外の層が持つ。
;; aiueos session/grant への配線は未実装（docs/aiueos-dapp.md の未実装境界）。
{:aiueos/component :app/dandori
 :aiueos/kind :app
 :aiueos/trust :untrusted
 :aiueos/source "dandori_core.cljk"
 :aiueos/wasm "dandori_core.wasm"
 :aiueos/entry "main"
 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/priority-rank
                   :app/estimate-valid?
                   :app/closed?
                   :app/active?
                   :app/transition-kind
                   :app/cycle-progress-permille
                   :app/sla-status
                   :app/next-number}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
